<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#0B1530" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="48"
            android:viewportHeight="48">
            <!-- Dial ring -->
            <path
                android:pathData="M24,8 a16,16 0 1,1 0,32 a16,16 0 1,1 0,-32"
                android:strokeColor="#3D5A99"
                android:strokeWidth="2"
                android:fillColor="#00000000" />
            <!-- Selection arc: 12 o'clock to 5 o'clock -->
            <path
                android:pathData="M24,8 A16,16 0 0 1 32,37.86"
                android:strokeColor="#22D3EE"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:fillColor="#00000000" />
            <!-- Knob at the end of the arc -->
            <path
                android:pathData="M29,37.86 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0"
                android:fillColor="#FFFFFF" />
            <!-- Center dot -->
            <path
                android:pathData="M21.5,24 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
                android:fillColor="#22D3EE" />
        </vector>
    </item>
</layer-list>
